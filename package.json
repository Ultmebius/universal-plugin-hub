{
  "name": "universal-plugin-hub",
  "title": "Universal Plugin Hub",
  "displayName": "Universal Plugin Hub",
  "description": "在 DSH 中使用 Claude Code、Codex 等软件生态的插件，一站式管理插件、Skills 与 MCP。支持添加自己的 Git 插件源、上传插件和 Skills、添加 MCP 服务器，自动扫描并开关本地 Skills，接入插件提供的子代理、MCP、Hooks 与 LSP。",
  "version": "1.0.25",
  "engines": {
    "dsh": ">=0.1.5-rc.1"
  },
  "type": "module",
  "main": "src/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ultmebius/universal-plugin-hub.git"
  },
  "homepage": "https://github.com/Ultmebius/universal-plugin-hub#readme",
  "bugs": {
    "url": "https://github.com/Ultmebius/universal-plugin-hub/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "marketplace",
    "claude",
    "plugins",
    "claude-code",
    "codex",
    "agent-skills",
    "mcp"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "js-yaml": "^5.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "scripts/postinstall.js",
    "cordis.patch.yml",
    "screenshots.json",
    "assets/Plugins-official.png",
    "assets/Skills.png",
    "assets/MCP.png",
    "assets/Plugin-management.png",
    "assets/Add-plugin-source.png",
    "assets/licenses/fluent-emoji.txt",
    "assets/fluent-3d"
  ],
  "devDependencies": {
    "react": "^19.2.0",
    "react-test-renderer": "^19.2.0",
    "acorn": "^8.18.0"
  }
}
